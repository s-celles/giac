# -----------------------------------------------------------------------------
# Directories (must allow dir first, then contents recursively)
# -----------------------------------------------------------------------------
!check/
!check/**
!debian/
!debian/**
!debianold/
!debianold/**
!doc/
!doc/**
!examples/
!examples/**
!icons/
!icons/**
!micropython
!.gitmodules
!po/
!po/**
!cross/
!cross/**
!scripts/
!scripts/**
!subprojects/
!subprojects/**
!src/
!src/**
!tests/
!tests/**
!.github/
!.github/**

# -----------------------------------------------------------------------------
# Meson build outputs (always ignore)
# -----------------------------------------------------------------------------
builddir/
cross/local/

# -----------------------------------------------------------------------------
# Classic C++ gitignore
# -----------------------------------------------------------------------------

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt 
compile_commands.json

# Temporary files
*.tmp 
*.log 
*.bak 
*.swp 

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/